{
  "name": "petshop-backend",
  "version": "1.0.0",
  "description": "Backend API for Petshop using Node.js, Express, and PostgreSQL",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "dev:front": "vite",
    "build": "tsc",
    "build:front": "vite build",
    "start": "node dist/src/server.js",
    "db:setup": "ts-node scripts/setup_db.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jspdf": "^4.2.1",
    "pg": "^8.12.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "nodemon": "^3.1.4",
    "oxlint": "^1.71.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.1"
  }
}
