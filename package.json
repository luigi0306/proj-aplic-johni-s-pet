{
  "name": "petshop-project",
  "version": "1.0.0",
  "description": "Petshop project with Express backend and React + Vite frontend",
  "main": "dist/src/backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --exec ts-node src/backend/server.ts",
    "dev:frontend": "vite",
    "build": "tsc",
    "build:frontend": "vite build",
    "start": "node dist/src/backend/server.js",
    "db:setup": "ts-node scripts/setup_db.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jspdf": "^4.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.4",
    "oxlint": "^1.71.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.1"
  }
}