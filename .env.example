# ──────────────────────────────────────────────────────────────────
# Copie este arquivo para .env e ajuste os valores antes de rodar
# o projeto. Nunca suba o .env com senhas reais para o repositório.
#
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────

# Porta em que o servidor Express vai escutar
PORT=3000

# Configurações do banco de dados
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=petshop
DB_PORT=5432

# URL completa de conexão (usada pelo backend e pelo script de setup)
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}

# Chave secreta para assinar os tokens JWT — TROQUE EM PRODUÇÃO
JWT_SECRET=troque_esse_valor_em_producao
